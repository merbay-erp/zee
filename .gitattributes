# Bütün metin dosyaları her platformda LF iner: Windows autocrlf'nin CRLF'i
# bayt bayt karşılaştırılan belgeleri (faz matrisi, kanıt özeti) bozar (K-182).
* text=auto eol=lf

# .dil kaynakları her platformda LF iner (deterministik bayt — bölüm 27).
*.dil text eol=lf

# HTTP fuzz korpusu wire satır sonlarını (CRLF/bare-LF) byte-byte korur.
compiler/fuzz/corpus/http_istegi/*.http binary

# WASM ABI korpusunun ilk kontrol baytı metin niteliğinde değildir.
compiler/fuzz/corpus/wasm_abi/* binary

# İndirilen çalışma ortamı raporlarının SHA-256 kanıtı ham byte'ları kapsar.
compiler/tests/fixtures/calisma-ortami-v1/*/*.json binary
# K-275 PDF ve özgün font lisansı exact kaynak baytlarıyla taşınır.
golden/pdf-host/assets/base.pdf binary
golden/pdf-host/assets/LICENSE-DejaVu.txt -text whitespace=-blank-at-eol

# Immutable acceptance logs retain original terminal blank lines.
docs/incelemeler/urunlesme-20261014/final-8b49113/e-archive-checks/E-doc-gates.log whitespace=-blank-at-eof
docs/incelemeler/urunlesme-20261014/final-8b49113/rc/campaign/logs/miri-ondalik.log whitespace=-blank-at-eof
docs/incelemeler/urunlesme-20261014/final-8b49113/rc/campaign/logs/miri-zaman.log whitespace=-blank-at-eof
