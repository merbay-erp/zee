# Panel Not Defteri — form akışını öğreten DENEYSEL localhost demosu.
# Öğretilen: form verisi (örtük "istek" sözlüğü), kaydet-sonrası yönlendirme,
# html güvenlisi (K-051), dosyada saklama. Yönetim gizli yoldadır:
# /yonet-gizli123 — anahtarı değiştirmeyi unutma!
# CSRF koruması vardır; gizli yol kimlik doğrulama sayılmadığı için bu
# örnek yine yalnız localhost eğitim/prototipi olarak kullanılır.
# Çalıştır: dil çalıştır --deneysel-web panel-not-defteri.dil
# Adres → http://127.0.0.1:8091

deneme "notlar.txt" dosyasını okumayı dene olsun
deneme başarısızsa
    "notlar.txt" dosyasına "İlk notun: bu satırı panelden ekledim demek için /yonet-gizli123 e git" yaz

işlem sayfayı giydir
    gövdeyi al

    stil "<style>body{font-family:Georgia,serif;max-width:640px;margin:40px auto;padding:0 16px;color:#1c1c28;background:#fbfaf7}h1{color:#b0413e}a{color:#2e6e4e}li{margin:6px 0}input{font:inherit;padding:8px;width:70%}button{font:inherit;padding:8px 18px}</style>" olsun
    sayfa "<!doctype html><html lang=tr><meta charset=utf-8>" ile stil ile gövde olsun
    sayfayı döndür

eylem notu kaydet
    notu Metin olarak al
    değer döndürmez
    "notlar.txt" dosyasına notu ekle

8091 kapısında sunucu başlat

GET "/" adresine istek geldiğinde
    liste "" olsun
    satırlar "notlar.txt" dosyasının satırları olsun
    her satır için
        liste liste ile "<li>" ile satırın html güvenlisi ile "</li>" olsun

    gövde "<h1>Not Defteri</h1><ul>" ile liste ile "</ul><p><i>Yönetim gizli yoldadır.</i></p>" olsun
    sayfa gövde için sayfayı giydir olsun
    sayfa yanıtını gönder

GET "/yonet-gizli123" adresine istek geldiğinde
    csrf csrf belirteci olsun
    form "<h1>Yeni not</h1><form method=post action=/kaydet-gizli123><input type=hidden name=_csrf value=\"" ile csrf ile "\"><input name=not placeholder=notunu-yaz autofocus> <button>Kaydet</button></form><p><a href=/>listeye dön</a></p>" olsun
    sayfa form için sayfayı giydir olsun
    sayfa yanıtını gönder

POST "/kaydet-gizli123" adresine istek geldiğinde
    herkese açık
    "not" alanı gerekli
    istekte "not" varsa
        yeni isteğin "not" değeri olsun
        yeni boşsa
            "/yonet-gizli123" adresine yönlendir
        değilse
            yeni ile notu kaydet
            "/" adresine yönlendir
    değilse
        "/yonet-gizli123" adresine yönlendir
