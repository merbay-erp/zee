# K-163 dogfood kanıt aynası.
# Kaynak: itwise-admin codex/k-163-catli-dogfood
# Exact ürün commit'i: cef5ae33b48264d9c271293d6746e7524f078c4a
# Son doğrulanan K-163/F030 saha kanıtı: 38dff9ffa40be0d08d670d1d1c54c04f6d45ef0c
# Son doğrulanan K-163/F031 TLS/havuz kanıtı: 977cd2aaf5d41089d5bff184ed7f583839b93ee0
# Bu dosya CI'ın dogfood ürün kökünü doğrulaması içindir; çalışan ürünün sahibi
# ayrı itwise-admin deposudur ve burada sahte bir tamamlanmış proje gösterilmez.

proje "catli-admin" olsun
sürüm "0.1.0" olsun
morfoloji "zee-tr-1" olsun
giriş "kaynak/ana.dil" olsun
yetkinlikler "dosya-okuma", "dosya-yazma", "ağ-sunucusu", "web-oturumu", "kriptografi", "veritabanı" listesi olsun
ağ_hedefleri boş liste olsun
yerel_bağımlılıklar boş liste olsun
veritabanı_hedefi "postgresql://db.example.internal:5432/catli_zee" olsun
veritabanı_bağlantı_değişkeni "CATLI_DATABASE_URL" olsun
veritabanı_göçleri "göçler" olsun
