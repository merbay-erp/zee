işlem yolHaritasiSayfasiniHazirla
    Metin döndürür
    gövde yolHaritasiGovdesiniHazirla olsun
    sayfa "V1 yol haritası" ve "/yol-haritasi/" ve gövde ile sayfayiHazirla olsun
    sayfayı döndür

işlem toplulukSayfasiniHazirla
    Metin döndürür
    gövde toplulukSayfasiGovdesiniHazirla olsun
    sayfa "Topluluk" ve "/topluluk/" ve gövde ile sayfayiHazirla olsun
    sayfayı döndür

işlem indirSayfasiniHazirla
    Metin döndürür
    gövde indirSayfasiGovdesiniHazirla olsun
    sayfa "Kurulum" ve "/indir/" ve gövde ile sayfayiHazirla olsun
    sayfayı döndür

test "anasayfa cümle çözümlemesi, örnek defteri ve dürüst durum taşır"
    gövde anasayfaGovdesiniHazirla olsun
    gövde "Cümle çözümlemesi" içermeli
    gövde "data-defter='turkce'" içermeli
    gövde "data-alanda-ac" içermeli
    gövde "/assets/brand/yildiz.svg" içermeli
    gövde "Çocuğun başlayabildiği" içermeli
    gövde "Henüz 1.0 değil" içermeli
    gövde "HATA T002" içermeli
    gövde "Bu site Zee ile yazıldı" içermeli

test "defter sekmesi kaynağı ve çıktıyı kaçışlı taşır"
    sekme "x" ve "\"a\" <b>yaz</b>" ve "<i>" ile defterSekmesi olsun
    sekme "&quot;a&quot; &lt;b&gt;yaz&lt;/b&gt;" içermeli
    sekme "<pre>&lt;i&gt;</pre>" içermeli

test "deneme sayfası dersleri ve gerçek derleyiciyi bağlar"
    gövde playgroundSayfasiGovdesiniHazirla olsun
    gövde "data-zee-workbench" içermeli
    gövde "id='zee-editor'" içermeli
    gövde "id='zee-run'" içermeli
    gövde "WASM ABI v3" içermeli
    gövde "<template data-ders" içermeli
    gövde "id='ders-ileri'" içermeli

test "dil turu yüklem kuralını ve V1 sınırını anlatır"
    gövde dilSayfasiGovdesiniHazirla olsun
    gövde "henüz 1.0 değildir" içermeli
    gövde "core freeze" içermeli
    gövde "yüklemi söyler" içermeli
    gövde "data-alanda-ac" içermeli

test "manifesto kökeni ve kanıt kültürünü açıklar"
    gövde manifestoSayfasiGovdesiniHazirla olsun
    gövde "Zeynep Eliz Erbay" içermeli
    gövde "Kanıt, iddiadan değerlidir" içermeli

test "kurulum sayfası Rust'sız kurulumu ve yayımlanmamış artefaktı dürüstçe anlatır"
    gövde indirSayfasiGovdesiniHazirla olsun
    gövde "--bin dil --bin dillsp" içermeli
    gövde "scripts/kur.sh" içermeli
    gövde "Henüz yayımlanmış bir sürüm artefaktı yok" içermeli
    gövde "self-hosting henüz tamamlanmadı" içermeli

test "belge merkezi bağlantıları sitedeki belge sayfalarına gider"
    gövde belgelerSayfasiGovdesiniHazirla olsun
    gövde "href='/belge/dil-turu/'" içermeli
    gövde "href='/belge/spec/'" içermeli
    gövde "href='/belge/'" içermeli
