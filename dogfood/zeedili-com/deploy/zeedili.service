[Unit]
Description=zeedili.com Zee web worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zeedili
Group=zeedili
WorkingDirectory=/opt/zeedili
ExecStart=/opt/zee/bin/dil çalıştır --web-proxy https://zeedili.com --web-worker-port 8126 /opt/zeedili
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
Environment=RUST_BACKTRACE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zeedili/.zee
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
