# K-247/B1: onay revizyonu başına tek kalıcı iş; mevcut SQL/eylem prototipi.
# SMTP/dosya/HTTP handler'ı yok. İş verisi hiçbir kod/SQL/callback adı çalıştırmaz.
# Native test sabit SQL handler'ını yalnız geçici projeye ekler.

eylem isKuyrugaEkle
    anahtar Metin olarak al
    revizyon Metin olarak al
    icerik Metin olarak al
    Metin sonucu döndürür
    parametreler anahtar, revizyon, icerik listesi olsun
    ekleme "INSERT INTO zee_jobs(business_key,approval_revision,payload) VALUES($1,$2::bigint,$3) ON CONFLICT(business_key,approval_revision) DO NOTHING" sorgusunu parametreler ile değiştirmeyi dene olsun
    ekleme başarılıysa
        okuma "SELECT id::text AS id FROM zee_jobs WHERE business_key=$1 AND approval_revision=$2::bigint AND payload=$3" sorgusunu parametreler ile okumayı dene olsun
        okuma başarılıysa
            kayitlar okumanın değeri olsun
            kayitlar boşsa
                "idempotency-icerigi-degisti" hatasını döndür
            kayit kayitların ilki olsun
            kayidin "id" değeri döndür
        "is-ekleme-okuma-hatasi" hatasını döndür
    "is-ekleme-depo-hatasi" hatasını döndür

eylem isKirala
    sahip Metin olarak al
    jeton Metin olarak al
    Metin sonucu döndürür
    kilitParametreleri boş liste olsun
    kilit "UPDATE zee_job_limits SET gate=gate+1 WHERE singleton" sorgusunu kilitParametreleri ile değiştirmeyi dene olsun
    kilit başarılıysa
        parametreler sahip, jeton listesi olsun
        kiralama "WITH aday AS (SELECT id FROM zee_jobs WHERE state IN ('ready','retry_wait') AND available_at<=clock_timestamp() AND attempts<3 AND (SELECT count(*) FROM zee_jobs WHERE state='leased' AND lease_expires>clock_timestamp())<(SELECT active_limit FROM zee_job_limits WHERE singleton) AND NOT EXISTS(SELECT 1 FROM zee_jobs WHERE state='leased' AND lease_owner=$1 AND lease_expires>clock_timestamp()) ORDER BY available_at,id FOR UPDATE SKIP LOCKED LIMIT 1) UPDATE zee_jobs SET state='leased',phase='reserved',lease_token=$2,lease_owner=$1,generation=generation+1,lease_expires=clock_timestamp()+interval '30 seconds' FROM aday WHERE zee_jobs.id=aday.id" sorgusunu parametreler ile değiştirmeyi dene olsun
        kiralama başarılıysa
            adet kiralamanın değeri olsun
            adet 0 a eşitse
                "bos" döndür
            okuma "SELECT id::text AS id,generation::text AS generation FROM zee_jobs WHERE state='leased' AND lease_owner=$1 AND lease_token=$2 AND lease_expires>clock_timestamp() AND phase='reserved'" sorgusunu parametreler ile okumayı dene olsun
            okuma başarılıysa
                kayitlar okumanın değeri olsun
                kayitlar boşsa
                    "kiralama-kaydi-yok" hatasını döndür
                kayit kayitların ilki olsun
                kimlik kayidin "id" değeri olsun
                nesil kayidin "generation" değeri olsun
                kimlik ile ":" ile nesil döndür
            "kiralama-okuma-hatasi" hatasını döndür
        "kiralama-depo-hatasi" hatasını döndür
    "kiralama-kilidi-hatasi" hatasını döndür

eylem isDenemesiniBaslat
    kimlik Metin olarak al
    jeton Metin olarak al
    nesil Metin olarak al
    TamSayı sonucu döndürür
    parametreler kimlik, jeton, nesil listesi olsun
    degisim "UPDATE zee_jobs SET attempts=attempts+1,phase='started' WHERE id=$1::bigint AND state='leased' AND lease_token=$2 AND generation=$3::bigint AND lease_expires>clock_timestamp() AND phase='reserved' AND attempts<3" sorgusunu parametreler ile değiştirmeyi dene olsun
    degisim başarılıysa
        adet degisimin değeri olsun
        adet 1 e eşit değilse
            "is-kirasi-gecersiz" hatasını döndür
        1 döndür
    "is-gecisi-depo-hatasi" hatasını döndür

eylem isHakkiniKilitle
    kimlik Metin olarak al
    jeton Metin olarak al
    nesil Metin olarak al
    TamSayı sonucu döndürür
    parametreler kimlik, jeton, nesil listesi olsun
    degisim "UPDATE zee_jobs SET generation=generation WHERE id=$1::bigint AND state='leased' AND lease_token=$2 AND generation=$3::bigint AND lease_expires>clock_timestamp() AND phase='started'" sorgusunu parametreler ile değiştirmeyi dene olsun
    degisim başarılıysa
        adet degisimin değeri olsun
        adet 1 e eşit değilse
            "is-kirasi-gecersiz" hatasını döndür
        1 döndür
    "is-gecisi-depo-hatasi" hatasını döndür

eylem isiTamamla
    kimlik Metin olarak al
    jeton Metin olarak al
    nesil Metin olarak al
    TamSayı sonucu döndürür
    parametreler kimlik, jeton, nesil listesi olsun
    degisim "UPDATE zee_jobs SET state='done',phase='none',lease_expires=NULL,last_outcome='completed' WHERE id=$1::bigint AND state='leased' AND lease_token=$2 AND generation=$3::bigint AND lease_expires>clock_timestamp() AND phase='started'" sorgusunu parametreler ile değiştirmeyi dene olsun
    degisim başarılıysa
        adet degisimin değeri olsun
        adet 1 e eşit değilse
            "is-kirasi-gecersiz" hatasını döndür
        1 döndür
    "is-gecisi-depo-hatasi" hatasını döndür

eylem isDenemesiniReddet
    kimlik Metin olarak al
    jeton Metin olarak al
    nesil Metin olarak al
    TamSayı sonucu döndürür
    parametreler kimlik, jeton, nesil listesi olsun
    degisim "WITH zaman AS (SELECT clock_timestamp() AS an) UPDATE zee_jobs SET state=CASE WHEN attempts=3 THEN 'dead_letter' ELSE 'retry_wait' END,phase='none',lease_expires=NULL,available_at=zaman.an+make_interval(secs=>power(2,attempts-1)::double precision),transitioned_at=zaman.an,last_outcome='idempotent-sql-attempt-failed' FROM zaman WHERE id=$1::bigint AND state='leased' AND lease_token=$2 AND generation=$3::bigint AND lease_expires>clock_timestamp() AND phase='started'" sorgusunu parametreler ile değiştirmeyi dene olsun
    degisim başarılıysa
        adet degisimin değeri olsun
        adet 1 e eşit değilse
            "is-kirasi-gecersiz" hatasını döndür
        1 döndür
    "is-gecisi-depo-hatasi" hatasını döndür

eylem suresiDolanIsleriBirak
    TamSayı sonucu döndürür
    parametreler boş liste olsun
    "UPDATE zee_jobs SET state=CASE WHEN attempts=3 THEN 'dead_letter' ELSE 'ready' END,phase='none',lease_expires=NULL,lease_token='',lease_owner='',available_at=clock_timestamp(),last_outcome='expired-idempotent-sql-lease' WHERE state='leased' AND lease_expires<=clock_timestamp()" sorgusunu parametreler ile değiştirmeyi dene döndür

# Uzlaştırma salt okur; C027 yazıyı/handler'ı burada tekrar çalıştırmaz.
işlem isDurumunuOku
    anahtar Metin olarak al
    revizyon Metin olarak al
    Metin sonucu döndürür
    parametreler anahtar, revizyon listesi olsun
    okuma "SELECT state::text AS state FROM zee_jobs WHERE business_key=$1 AND approval_revision=$2::bigint" sorgusunu parametreler ile okumayı dene olsun
    okuma başarılıysa
        kayitlar okumanın değeri olsun
        kayitlar boşsa
            "yok" döndür
        kayit kayitların ilki olsun
        kayidin "state" değeri döndür
    "uzlastirma-depo-hatasi" hatasını döndür
