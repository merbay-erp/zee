# K-232/B2: gerçek katalog PDF e-posta talebinin anonim ürün reproducer'ı.
# Sır ortamdan gelir; canlı ürün dosyası veya SMTP kabulü değildir.
alici "recipient@example.invalid" olsun
konu "Katalog Şalça" olsun
duz "Katalog PDF'i ektedir. / The catalogue PDF is attached." olsun
html "<p>Katalog PDF'i ektedir.</p><p>The catalogue PDF is attached.</p>" olsun
yanit "reply@example.invalid" olsun
ekler "katalog.pdf" listesi olsun
baglanti "" olsun
sonuc alici konu duz html yanit ekler baglanti ile ekli ileti göndermeyi dene olsun
sonuc başarılıysa
    sonucun değeri yaz
değilse
    sonucun hatası yaz
