# K-208/K-209/K-220/K-223/K-227 anonim gereksinim aynası; çalışan ürün ayrı depodadır.
proje "zee-cekirdek" olsun
sürüm "0.1.0" olsun
morfoloji "zee-tr-1" olsun
giriş "kimlik-gereksinimi.dil" olsun
yetkinlikler "ağ-sunucusu", "web-oturumu", "kriptografi", "ağ", "veritabanı" listesi olsun
ağ_hedefleri "https://challenges.cloudflare.com" listesi olsun
http_gizli_değişkenleri "TURNSTILE_SECRET" listesi olsun
veritabanı_hedefi "postgresql://127.0.0.1:5432/anonim" olsun
veritabanı_bağlantı_değişkeni "ZEE_DOGFOOD_DATABASE_URL" olsun
veritabanı_göçleri "gocler" olsun
yerel_bağımlılıklar boş liste olsun
