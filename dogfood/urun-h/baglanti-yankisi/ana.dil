# K-381 (RFC-0039 A2a): ürün H SMTP alıcısının bağlantı tarafı. Durum
# makinesi ürünün saf SMTP komut çözümleyicisinin küçültülmüş hâlidir; satır
# kuralı (CRLF, çıplak CR/LF reddi, uzunluk) ve zaman aşımı çalışma zamanı
# değişmezidir, protokol yanıtı Zee'nin kararıdır. STARTTLS'te tamponda
# bekleyen düz metin varsa çalışma zamanı yükseltmeyi reddedip bağlantıyı
# kapatır (A2b); başarıda EHLO durumu sıfırlanır (ürün durum makinesinin işi).
# K-384 (A2c): DATA gövdesi belleğe alınmadan geçici dosyaya akar (yalnız
# birebir CRLF.CRLF biter; çıplak LF/CR smuggling'i 554, sınır 552); ürün
# dosyayı `atomik taşımayı dene` ile posta kutusuna taşır. IDLE kesiti (ürünün
# IMAP motorundan) kısa süreli okumayla yoklar; zaman aşımı oturumu bitirmez.

işlem oturumu sür
    bağlantıya "220 mx.ornek.test ESMTP" satırını yaz
    açık doğru olsun
    açık olduğu sürece
        komut bağlantıdan satır okumayı dene olsun
        komut başarılıysa
            metin komutun değeri olsun
            metin "QUIT" e eşitse
                bağlantıya "221 2.0.0 hoşça kal" satırını yaz
                açık yanlış olsun
            değilse metin "DATA" e eşitse
                bağlantıya "354 ileti bitince <CRLF>.<CRLF>" satırını yaz
                ileti bağlantıdan nokta bloğunu dosyaya almayı dene olsun
                ileti başarılıysa
                    künye iletinin değeri olsun
                    bağlantıya "250 2.0.0 alındı " ile künyenin "bayt" değeri satırını yaz
                değilse
                    sorun iletinin hatası olsun
                    ayrıntı sorunun verisi olsun
                    neden ayrıntının "tür" değeri olsun
                    neden "boyut_aşımı" e eşitse
                        bağlantıya "552 5.3.4 ileti çok büyük" satırını yaz
                    değilse
                        neden "satır_sonu" e eşitse
                            bağlantıya "554 5.6.0 çıplak satır sonu" satırını yaz
                        değilse
                            son bağlantıya "421 4.4.2 ileti yarıda kaldı" satırını yazmayı dene olsun
                            açık yanlış olsun
            değilse metin "IDLE" e eşitse
                bağlantıya "+ idling" satırını yaz
                bekliyor doğru olsun
                bekliyor olduğu sürece
                    satır bağlantıdan satır okumayı 1 saniye içinde dene olsun
                    satır başarılıysa
                        bağlantıya "OK IDLE bitti" satırını yaz
                        bekliyor yanlış olsun
                    değilse
                        sorun satırın hatası olsun
                        ayrıntı sorunun verisi olsun
                        neden ayrıntının "tür" değeri olsun
                        neden "zaman_aşımı" e eşitse
                            bağlantıya "* yoklama" satırını yaz
                        değilse
                            bekliyor yanlış olsun
                            açık yanlış olsun
            değilse metin "STARTTLS" e eşitse
                bağlantıya "220 2.0.0 TLS için hazır" satırını yaz
                tls bağlantıda TLS başlatmayı dene olsun
                tls başarısızsa
                    açık yanlış olsun
            değilse
                metin "NOOP" e eşitse
                    bağlantıya "250 2.0.0 tamam" satırını yaz
                değilse
                    bağlantıya "502 5.5.2 komut tanınmadı" satırını yaz
        değilse
            hata komutun hatası olsun
            veri hatanın verisi olsun
            tür verinin "tür" değeri olsun
            tür "kapandı" e eşitse
                açık yanlış olsun
            değilse
                tür "zaman_aşımı" e eşitse
                    bağlantıya "421 4.4.2 zaman aşımı" satırını yaz
                    açık yanlış olsun
                değilse
                    tür "kapanıyor" e eşitse
                        bağlantıya "421 4.3.2 hizmet kapanıyor" satırını yaz
                        açık yanlış olsun
                    değilse
                        tür "satır_uzun" e eşitse
                            bağlantıya "500 5.5.6 satır çok uzun" satırını yaz
                        değilse
                            bağlantıya "500 5.5.2 sözdizimi hatası" satırını yaz
    bağlantıyı kapat

"smtp_v4" dinleyicisinde bağlantı geldiğinde
    oturumu sür

"smtp_v6" dinleyicisinde bağlantı geldiğinde
    oturumu sür

"smtps_v4" dinleyicisinde bağlantı geldiğinde
    oturumu sür

"smtps_v6" dinleyicisinde bağlantı geldiğinde
    oturumu sür
