# K-395 (RFC-0043 Dilim 2 kısmi, ZM-F039): ürün H posta motorunun büyük ek
# çıkarma kesiti. 25 MB'lık iletinin ~18 MB'lık tek base64 eki bayt aramayla
# bulunur ve tek çağrıda dosyadan dosyaya akışla çözülür.
proje "buyuk-ek" olsun
sürüm "0.1.0" olsun
morfoloji "zee-tr-1" olsun
giriş "ana.dil" olsun
yetkinlikler "ağ-dinleyici", "dosya-okuma", "dosya-yazma" listesi olsun
ağ_hedefleri boş liste olsun
dinleyiciler "smtp_v4 0.0.0.0:25" listesi olsun
bağlantı_blok_sınırı 26214400 olsun
