# K-395 (RFC-0043 Dilim 2 kısmi, ZM-F039): ürün H SMTP alıcısının büyük ek
# kesiti. DATA gövdesi A2c ile dosyaya alınır. Ürünün MIME ayrıştırıcısı
# parçanın `Content-Transfer-Encoding: base64` başlığını, başlık bölümünü
# bitiren boş satırı ve kapanış sınırını BAYT konumu olarak arar; ek gövdesi
# tek çağrıda dosyadan dosyaya çözülür. Değişiklik öncesi: satır satır okuma
# ~4,7 MB'ta C024 (K-393), 1 MiB pencereli Dilim 1 çözümünde gövdenin bayt
# başlangıcı bulunamıyordu (harf ≠ bayt), 16 MiB hedef tavanı 18 MB eke
# yetmiyordu; kalıplar S015 verirdi.

işlem sonraki satır
    bloku Metin olarak al
    konumu TamSayı olarak al
    TamSayı döndürür
    # Satır sonu CRLF'dir; LF'nin bir sonrası satır başıdır. Bulunamazsa -1.
    arama bloku dosyasında konumu baytından "\n" aramayı dene olsun
    arama başarılıysa
        yer aramanın değeri olsun
        yer 0 dan küçükse
            -1 döndür
        artis 1 olsun
        yer ile artisin toplamı döndür
    -1 döndür

işlem gövde sonu
    bloku Metin olarak al
    basi TamSayı olarak al
    siniri Metin olarak al
    TamSayı döndürür
    arama bloku dosyasında basi baytından siniri aramayı dene olsun
    arama başarılıysa
        aramanın değeri döndür
    -1 döndür

işlem eki çıkar
    bloku Metin olarak al
    siniri Metin olarak al
    hedefi Metin olarak al
    Metin döndürür
    arama bloku dosyasında 0 baytından "Content-Transfer-Encoding: base64" aramayı dene olsun
    arama başarısızsa
        "451 4.3.0 ileti taranamadı" döndür
    yanit "250 2.0.0 ek yok" olsun
    arama başarılıysa
        baslik aramanın değeri olsun
        # Başlık satırının ardından boş satır gelir; gövde ondan sonraki bayttır.
        bos_satir bloku ve baslik ile sonraki satır olsun
        govde_basi bloku ve bos_satir ile sonraki satır olsun
        govde_sonu bloku ve govde_basi ve siniri ile gövde sonu olsun
        uzunluk govde_sonu ile govde_basinin farkı olsun
        baslik 0 dan küçükse
            yanit "250 2.0.0 ek yok" olsun
        değilse
            uzunluk 1 den küçükse
                yanit "554 5.6.0 bozuk MIME parçası" olsun
            değilse
                cikarma bloku dosyasının govde_basi baytından uzunluk baytını base64 çözerek hedefi dosyasına eklemeyi dene olsun
                cikarma başarılıysa
                    tutamak cikarmanın değeri olsun
                    yanit "250 2.0.0 " ile tutamağın "sha256" değeri olsun
                değilse
                    hata cikarmanın hatası olsun
                    veri hatanın verisi olsun
                    yanit "554 5.6.0 ek çözülemedi: " ile verinin "tür" değeri olsun
    yanit döndür

"smtp_v4" dinleyicisinde bağlantı geldiğinde
    bağlantıya "220 mx.ornek.test ESMTP" satırını yaz
    ileti bağlantıdan nokta bloğunu dosyaya almayı dene olsun
    ileti başarılıysa
        künye iletinin değeri olsun
        blok künyenin "yol" değeri olsun
        yanit blok ve "--sinir--" ve "ekler/gelen.parca" ile eki çıkar olsun
        bağlantıya yanit satırını yaz
    bağlantıyı kapat
