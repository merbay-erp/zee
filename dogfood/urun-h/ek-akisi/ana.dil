# K-378 (RFC-0041 A): ürün H webmail'inin ek görüntüleme ve kişi dışa aktarma
# rotalarının anonim kesiti. Ürün ikili ekte "İndirme yakında" gösteriyor,
# vCard/CSV'yi text/plain + <a download> ile geçiştiriyordu. Ek yolunun hangi
# kullanıcıya ait olduğu (IDOR) ürün kararıdır; burada kimlik → yol eşlemesi
# oturum sahibine bağlı sabit tabloyla temsil edilir.

işlem ek yolu
    sahibi Metin olarak al
    kimliği Metin olarak al
    Metin döndürür
    sahibi "ornek" e eşitse
        kimliği "1" e eşitse
            "veri/ekler/1.parca" döndür
    "" döndür

işlem dışa aktarım türü
    biçimi Metin olarak al
    Metin döndürür
    biçimi "vcard" e eşitse
        "text/plain" döndür
    "text/csv" döndür

8080 kapısında sunucu başlat

GET "/posta/ek" adresine istek geldiğinde
    oturum gerekli
    sahip oturumun "kullanıcı" değeri olsun
    kimlik "" olsun
    istekte "id" varsa
        kimlik isteğin "id" değeri olsun
    yol sahip ve kimlik ile ek yolu olsun
    yol boşsa
        "Bu ek yok ya da size ait değil." yanıtını 404 durumuyla gönder
    değilse
        sonuç yol dosyasını "application/pdf" türünde "fatura Ekim.pdf" adıyla ek olarak göndermeyi dene olsun
        sonuç başarısızsa
            "Ek okunamadı." yanıtını 404 durumuyla gönder

GET "/kisiler/disa-aktar" adresine istek geldiğinde
    oturum gerekli
    biçim "vcard" olsun
    istekte "bicim" varsa
        biçim isteğin "bicim" değeri olsun
    tür biçim ile dışa aktarım türü olsun
    sonuç "veri/disa-aktar/kisiler.txt" dosyasını tür türünde "kişiler.vcf" adıyla ek olarak göndermeyi dene olsun
    sonuç başarısızsa
        "Dışa aktarım hazır değil." yanıtını 503 durumuyla gönder
