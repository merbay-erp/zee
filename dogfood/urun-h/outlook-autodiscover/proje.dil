# K-405: ürün H web arayüzünün (ZeeMail) klasik Outlook POX autodiscover
# rotasının anonim kesiti.
proje "outlook-autodiscover" olsun
sürüm "0.1.0" olsun
morfoloji "zee-tr-1" olsun
giriş "ana.dil" olsun
yetkinlikler "ağ-sunucusu", "web-oturumu", "dosya-okuma" listesi olsun
ağ_hedefleri boş liste olsun
