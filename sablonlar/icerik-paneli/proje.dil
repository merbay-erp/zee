proje "icerik-paneli" olsun
sürüm "0.1.0" olsun
morfoloji "zee-tr-1" olsun
giriş "ana.dil" olsun
yetkinlikler "dosya-okuma", "dosya-yazma", "ağ-sunucusu", "web-oturumu", "kriptografi", "veritabanı" listesi olsun
ağ_hedefleri boş liste olsun
yerel_bağımlılıklar boş liste olsun
veritabanı_hedefi "postgresql://localhost:5432/zee_starter" olsun
veritabanı_bağlantı_değişkeni "ZEE_STARTER_DATABASE_URL" olsun
veritabanı_göçleri "gocler" olsun
