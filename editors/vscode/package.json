{
  "name": "dil-vscode",
  "displayName": "Türkçe Programlama Dili (.dil)",
  "description": "Türkçe programlama dili için sözdizimi renklendirme ve düzenleyici desteği (çalışma adı: zee)",
  "version": "0.1.0",
  "publisher": "zee-dil",
  "license": "SEE LICENSE IN ../../README.md",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dil",
        "aliases": [
          "Türkçe Programlama Dili",
          "dil"
        ],
        "extensions": [
          ".dil"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dil",
        "scopeName": "source.dil",
        "path": "./syntaxes/dil.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "dil",
      "properties": {
        "dil.lspYolu": {
          "type": "string",
          "default": "dillsp",
          "description": "dillsp ikilisinin yolu (PATH'te değilse tam yol ver)."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:dil"
  ]
}